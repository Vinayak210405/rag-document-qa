# Copy to .env and edit. Never commit .env. All variables use the RAG_ prefix.

RAG_LOG_LEVEL=INFO
RAG_STORAGE_DIR=storage

# --- Embeddings ---------------------------------------------------------------
# sentence_transformers = real semantic embeddings (needs: uv sync --extra embeddings; downloads ~130 MB once)
# hashing               = offline, non-semantic, no download (for trying the app / tests)
RAG_EMBEDDING_BACKEND=sentence_transformers
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# An index is tied to the embedding model that built it. Switching models needs a new RAG_STORAGE_DIR.

# --- Chunking / retrieval (sizes in characters) ----------------------------------
RAG_CHUNK_MAX_CHARS=500
RAG_CHUNK_OVERLAP_CHARS=80
RAG_DEFAULT_TOP_K=4

# --- LLM: any OpenAI-compatible endpoint. Default: local Ollama (free, no key) ---
RAG_LLM_BASE_URL=http://localhost:11434/v1
RAG_LLM_MODEL=llama3.2:3b
# RAG_LLM_API_KEY=            # only for hosted providers (OpenAI, Groq, ...)
RAG_LLM_TIMEOUT_SECONDS=120
