# Copy to .env and edit. Never commit .env.
# All variables use the RAG_ prefix.

RAG_LOG_LEVEL=INFO

# Embedding model (downloaded from Hugging Face on first use, ~130 MB).
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Any OpenAI-compatible endpoint. Default: local Ollama (free, no key needed).
RAG_LLM_BASE_URL=http://localhost:11434/v1
RAG_LLM_MODEL=llama3.2:3b
# Only needed for hosted providers (OpenAI, Groq, ...). Leave unset for Ollama.
# RAG_LLM_API_KEY=
